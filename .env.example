# ══════════════════════════════════════════════════
# TradingProSystem — Plantilla de Variables de Entorno
# ══════════════════════════════════════════════════
# Renombrar este archivo a ".env" y completar los valores reales.

# ── Alpaca Broker ──
ALPACA_API_KEY=your_alpaca_api_key_here
ALPACA_SECRET_KEY=your_alpaca_secret_key_here
ALPACA_PAPER=True

# ── Telegram Notifications ──
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# ── API Security ──
TRADING_API_KEY=your_secure_api_key_min_16_chars

# ── Environment Mode ──
# Cambiar a "prod" en el VPS para activar modo producción
TRADING_ENV=dev
