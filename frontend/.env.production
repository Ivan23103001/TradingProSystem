# Frontend environment variables for production VPS (DigitalOcean)
# ⚠️  NO guardar secretos aquí — las variables VITE_ se empaquetan en el bundle
# VITE_API_URL vacío = rutas relativas (/api/...) que fluyen a través de Nginx
VITE_API_URL=
# VITE_API_KEY se inyecta en tiempo de build desde el servidor CI o manualmente
# Ejemplo: VITE_API_KEY=valor_generado_con_openssl_rand_hex_16
